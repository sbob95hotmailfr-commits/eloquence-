# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Utilisée uniquement côté serveur (jamais exposée au client) pour des opérations privilégiées.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Transcription (Whisper via OpenAI, ou tout fournisseur compatible) —
# la même clé sert aussi à la synthèse vocale (text-to-speech).
OPENAI_API_KEY=sk-xxxxxxxxxxxx
TRANSCRIPTION_MODEL=whisper-1

# Notifications push (rappels intelligents) — générez une paire de clés VAPID
# avec `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Secret partagé vérifié sur chaque appel du cron Vercel (/api/cron/reminders).
CRON_SECRET=a-long-random-string
